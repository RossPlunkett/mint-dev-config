#!/usr/bin/env bash
# Open GNOME Terminal and visibly type `cd <ROF_WORKSPACE>/csoundfreak && omp`.
set -euo pipefail

fail() {
    notify-send 'o' "$1" 2>/dev/null || true
    printf 'o: %s\n' "$1" >&2
    exit 1
}

command -v xdotool >/dev/null 2>&1 || fail 'xdotool is not installed (sudo apt install xdotool)'

KEY_DELAY_MS="${O_KEY_DELAY_MS:-40}"
target="${ROF_WORKSPACE:-$HOME/dev/ross-o-fone}/csoundfreak"
[[ -d "$target" ]] || fail "missing checkout: $target"

before="$(xdotool getactivewindow 2>/dev/null || echo none)"
gnome-terminal &

# Wait (up to 10s) for the new terminal window to take focus.
terminal=
for _ in $(seq 500); do
    active="$(xdotool getactivewindow 2>/dev/null || echo none)"
    if [[ "$active" != none && "$active" != "$before" ]] &&
        xprop -id "$active" WM_CLASS 2>/dev/null | grep -qi terminal; then
        terminal="$active"
        break
    fi
    sleep 0.02
done
[[ -n "$terminal" ]] || fail 'terminal window never appeared'
sleep 0.3 # let bash print its prompt

# No --window: gnome-terminal ignores XSendEvent input, so type into the focused window.
# `&&` keeps omp from starting anywhere but the checkout if cd fails.
xdotool type --delay "$KEY_DELAY_MS" -- "cd -- $(printf '%q' "$target") && omp"
xdotool key Return
