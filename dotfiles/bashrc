# Managed by mint-dev-config.
case $- in
    *i*) ;;
    *) return ;;
esac

HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000
shopt -s histappend checkwinsize

if [[ -x /usr/bin/dircolors ]]; then
    eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
fi

alias ll='ls -alF'
alias la='ls -A'
alias alert='notify-send --urgency=low "$(history 1)"'

if [[ -r /usr/share/bash-completion/bash_completion ]]; then
    source /usr/share/bash-completion/bash_completion
fi

if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"

export PATH="$HOME/.local/bin:$PATH"
export ROF_WORKSPACE="${ROF_WORKSPACE:-$HOME/dev/ross-o-fone}"
export KARAOKE_WORKSPACE="${KARAOKE_WORKSPACE:-$HOME/dev/liquid-live-karaoke}"

alias csf='cd "$ROF_WORKSPACE/csoundfreak"'
alias rofs='cd "$ROF_WORKSPACE/ross-o-fone-server"'
alias sauce='cd "$ROF_WORKSPACE/Sauce"'
alias builddesktop='"$ROF_WORKSPACE/csoundfreak/builddesktop.sh"'
alias buildvst='"$ROF_WORKSPACE/csoundfreak/buildvst.sh"'
alias rundesktop='"$ROF_WORKSPACE/csoundfreak/rundesktop.sh"'
alias l='lazygit'
alias n='nvim'
alias npd='npm run dev'

cdd() {
    local finder dir
    command -v fzf >/dev/null 2>&1 || { printf 'cdd: fzf is not installed\n' >&2; return 1; }
    finder="$(command -v fd 2>/dev/null || command -v fdfind 2>/dev/null || true)"
    if [[ -n "$finder" ]]; then
        dir="$($finder --type d --hidden --exclude .git . | fzf --height=40% --reverse)"
    else
        dir="$(find . -mindepth 1 -type d -not -path '*/.git/*' -printf '%P\n' | fzf --height=40% --reverse)"
    fi
    [[ -n "$dir" ]] && cd "$dir"
}

if [[ -d "$HOME/android-studio" ]]; then
    export CAPACITOR_ANDROID_STUDIO_PATH="$HOME/android-studio/bin/studio.sh"
    export JAVA_HOME="$HOME/android-studio/jbr"
fi
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export PATH="${JAVA_HOME:+$JAVA_HOME/bin:}$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"

[[ -r "$HOME/.railway/env" ]] && source "$HOME/.railway/env"

