{
  "defaultThinkingLevel": "medium",
  "theme": "felix-night",
  "tuiMode": "fullscreen",
  "quietStartup": "header",
  "terminal": {
    "showImages": true,
    "showTerminalProgress": true
  },
  "subagents": {
    "defaultThinking": "medium",
    "agentOverrides": {
      "worker": {
        "tools": "inherit"
      },
      "delegate": {
        "tools": "inherit"
      },
      "scout": {
        "tools": "inherit"
      },
      "reviewer": {
        "tools": "inherit"
      },
      "researcher": {
        "tools": "inherit"
      },
      "oracle": {
        "tools": "inherit"
      },
      "evidence-auditor": {
        "tools": "inherit"
      }
    }
  },
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "piOmpTheme": {
    "preset": "omp",
    "theme": {
      "autoApply": "felix-night"
    }
  },
  "defaultProjectTrust": "always",
  "markdown": {
    "mermaid": "streaming"
  },
  "extensions": [
    "-builtin:mcp"
  ]
}
